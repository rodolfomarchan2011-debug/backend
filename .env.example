# ---------------- API do portal (Render) ----------------
# Conexao do banco isolado do clube (TiDB). Se vazio, deriva de DIANA_DATABASE_URL
# trocando o banco para clube_diana.
CLUBE_DATABASE_URL=mysql://USUARIO:SENHA@HOST:4000/clube_diana

# Segredo do JWT (gere um valor aleatorio e NAO commite).
CLUBE_JWT_SECRET=troque-por-um-valor-aleatorio-longo

# Horas de validade do token de login.
CLUBE_TOKEN_HOURS=12

# Origens liberadas para o site (separadas por virgula).
CLUBE_ALLOWED_ORIGINS=https://clube-diana.onrender.com,http://localhost:5500,http://127.0.0.1:5500

# Expor /docs, /redoc e /openapi.json (1 = liga). Em producao fica desligado.
CLUBE_DOCS=0

# Tamanho do pool de conexoes MySQL por processo.
CLUBE_DB_POOL=8

# ---------------- Agente local (sync) ----------------
# Leitura do SIM (somente SELECT).
DIANA_SIM_VIVO_DATABASE_URL=postgresql://leitura_vivo:...@127.0.0.1:5432/SIM

# Escrita no SIM (usuario restrito escrita_pessoas: so INSERT Pessoa/Cliente).
DIANA_SIM_ESCRITA_URL=postgresql://escrita_pessoas:...@127.0.0.1:5432/SIM

# Fonte para derivar o banco do clube, caso CLUBE_DATABASE_URL esteja vazio.
DIANA_DATABASE_URL=mysql://USUARIO:SENHA@HOST:4000/financeiro_diana

# Janela inicial do pull de vendas (dias), quando ainda nao ha watermark.
COMPRAS_DIAS_INICIAIS=90
